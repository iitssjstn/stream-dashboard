# ---- Required ----
# Create an app at https://dev.twitch.tv/console/apps
# OAuth Redirect URL in the Twitch console must be exactly: <PUBLIC_URL>/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# The address where streamers/OBS reach this app (no trailing slash).
# Local use:      http://localhost:3000
# With a domain:  https://overlay.jouwdomein.nl  (put a TLS reverse proxy in front -> wss:// automatically)
PUBLIC_URL=http://localhost:3000

# Port on the host machine (docker compose)
HOST_PORT=3000

# ---- Optional ----
# 32 random bytes, base64. Encrypts Twitch tokens at rest. If empty, one is generated
# and stored in the data volume. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=info
