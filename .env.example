# Non-secret settings only. Twitch credentials go in ./secrets/ (see README), never in here.

# The address where streamers/OBS reach this app (no trailing slash).
# Local use:      http://localhost:3000
# With a domain:  https://overlay.jouwdomein.nl  (TLS reverse proxy in front -> wss:// automatically)
PUBLIC_URL=http://localhost:3000

# Port on the host machine (docker compose)
HOST_PORT=3000
